
<%layout("listing/layouts/boilerplate")%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
        
     
    <div class="card col-8 offset-2">
        <h1>Listing details</h1>
        <img src="<%=  listingss.image.url %>" class="card-img-top show-img" alt="listing_image" />
         
    <h5 class="card-title"><%= listingss.title %></h5>
    <p class-card-text>
        <%= listingss.title %><br>
        <%=listingss.description%><br>
        &#8377;<%=listingss.price ? listingss.price.toLocaleString("en-IN") : "N/A" %><br>
        <%=listingss.location%><br>
        <%=listingss.country%><br>
         </p>
    
    </div>
        
       <div class=" btns">
            <a href="/listings/<%=listingss._id%>/edit" class="btn btn-dark col-1 offset-2 edit-btn">Edit</a>
     
            <form method="POST" action="/listings/<%=listingss._id%>?_method=DELETE">
            <button class="btn btn-dark offset-4">Delete</button>
            
            
     </form>
     </div>
   
     </div>
     </div>
    

     
     
</body>
